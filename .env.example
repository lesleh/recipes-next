# Local development, against the database in docker-compose.yml.
DATABASE_URL="postgresql://recipes:recipes@localhost:5432/recipes"

# In production this is the Neon connection string from Vercel > Storage.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Vercel Blob read/write token. Leave it unset and photos are written to
# public/uploads instead, which is what local development uses.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Where the site answers, with its scheme. Only needed for a self-hosted run on
# its own domain. Vercel provides the domain itself, and local development
# falls back to http://localhost:3000.
# SITE_URL="https://recipes.example.com"

# Password for the new, edit and delete pages. Reading needs no password. Any
# username works at the browser prompt, so only this has to match. In production
# set it under Settings > Environment Variables in the Vercel project; a
# production build fails without it.
RECIPES_WRITE_PASSWORD="recipes"

# Vercel AI Gateway key, for the pages that write and change a recipe with AI
# and for the recipe illustrations. Make one under AI Gateway > API keys in the
# Vercel dashboard. Leave it unset and the AI pages and the edit page's draw
# button say it is not set up, new recipes get no drawing, and the build still
# passes.
# AI_GATEWAY_API_KEY="vck_..."
