# Local development, against the database in docker-compose.yml.
DATABASE_URL="postgresql://recipes:recipes@localhost:5432/recipes"

# In production this is the Neon connection string from Vercel > Storage.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Vercel Blob read/write token. Leave it unset and photos are written to
# public/uploads instead, which is what local development uses.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Password for the new, edit and delete pages. Reading needs no password. Any
# username works at the browser prompt, so only this has to match. In production
# set it under Settings > Environment Variables in the Vercel project; a
# production build fails without it.
RECIPES_WRITE_PASSWORD="recipes"
