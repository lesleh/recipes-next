# The test database in docker-compose.yml. Committed, because it holds no
# secret and only ever reaches a throwaway container on this machine.
#
# Start it before running the tests:
#   docker compose up -d --wait postgres-test
#
# The database name has to end in "_test". The suite refuses to run otherwise,
# because it empties the tables between tests.
DATABASE_URL="postgresql://recipes:recipes@localhost:5433/recipes_test"

# The write password the action tests sign in with. Only ever compared against
# itself, so its value does not matter.
RECIPES_WRITE_PASSWORD="test-password"
